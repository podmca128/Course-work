                cFName = custInfo[0]
                cSName = custInfo[1]
                cursor = connection.cursor()
                cursor.execute("SELECT sessionName FROM tblsession WHERE sessionID = ?", [sessionID])
                sessionInfo = cursor.fetchone()
                sessionName = sessionInfo
                cursor.execute("SELECT rentalEquipmentName FROM tblrental WHERE rentalID = ?", [rentalID])
                rentalInfo = cursor.fetchone()
                rentalEquipmentName = rentalInfo
                cursor.execute("SELECT storageEquipmentName FROM tblstorage WHERE storageID = ?", [storageID])
                storageInfo = cursor.fetchone()
                storageEquipmentName = storageInfo

                bookings = [bookingID, cFName, cSName, sessionName, rentalEquipmentName, storageEquipmentName, cost, bookingPaid]
                bookingDetails.append(bookings)

            clicked1= clicked.get()

            #if statement which correspond order to selected value from filter by menu
            if clicked1 == "First Name":
                bookingDetails = sorted(bookingDetails, key=lambda x: x[1])
            elif clicked1 == "Surname":
                bookingDetails = sorted(bookingDetails, key=lambda x: x[2])
            elif clicked1 == "Booking ID":
