        def DisplayData(search_term=""):
            # Open a connection to the kayak.db database
            connection = sqlite3.connect("kayak.db")
            # Create a cursor object
            cursor = connection.cursor()
            # Clear the current data
            ttree.delete(*ttree.get_children())
            # Execute an SQL SELECT statement with a WHERE clause to filter the results based on the search term
            sql = "SELECT * FROM tblstorage"
            if search_term:
                sql += f" WHERE storageCustomerName LIKE '%{search_term}%' "
            cursor.execute(sql)
            rows = cursor.fetchall()
            #getting the value that user wants display to be filtered by
            clicked1 = clicked.get()

             #if statement which correspond order to selected value from filter by menu
            if clicked1 == "Storage equipment name":
                rows = sorted(rows, key=lambda x: x[1])
            elif clicked1 == "Storage cost":
                rows = sorted(rows, key=lambda x: x[4])
            elif clicked1 == "Storage ID":
                rows = sorted(rows, key=lambda x: x[0])
            elif clicked1 == "Storage date":
                rows = sorted(rows, key=lambda x: x[8])
            # Add the search results to the tree view
            for row in rows:
                ttree.insert("", "end", values=row)

