        def DisplayData(search_term=""):
            #Open a connection to the kayak.db database
            connection = sqlite3.connect("kayak.db")
            #Create a cursor object
            cursor = connection.cursor()
            #Clear the current data
            ttree.delete(*ttree.get_children())
            #Execute an SQL SELECT statement with a WHERE clause to filter the results based on the search term
            sql = "SELECT tblbooking.*, tblcustomer.customerFirstName, tblcustomer.customerSurname, tblsession.sessionName, tblrental.rentalEquipmentName, tblstorage.storageEquipmentName FROM tblbooking JOIN tblcustomer ON tblbooking.customerID = tblcustomer.customerID JOIN tblsession ON tblbooking.sessionID = tblsession.sessionID JOIN tblrental ON tblbooking.rentalID = tblrental.rentalID JOIN tblstorage ON tblbooking.storageID = tblstorage.storageID"
            if search_term:
                sql += f" WHERE customerFirstName LIKE '%{search_term}%' OR customerSurname LIKE '%{search_term}%' OR sessionName LIKE '%{search_term}%' OR rentalEquipmentName LIKE '%{search_term}%' OR storageEquipmentName LIKE '%{search_term}%' OR bookingPaid LIKE '%{search_term}%'"
            cursor.execute(sql)
            rows = cursor.fetchall()


            # Add the search results to the tree viewd
            bookingDetails = []
            for row in rows:
                bookingID = row[0]
                customerID = row[1]
                sessionID = row[2]
                rentalID = row[3]
                storageID = row[4]
                cost = row[5]
                bookingPaid = row[6]

