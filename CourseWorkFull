            elif clicked1 == "Booking Paid":
                bookingDetails = sorted(bookingDetails, key=lambda x: x[6])

            #Add the search results to the tree view
            for row in bookingDetails:
                ttree.insert("", "end", values=row)
        
        #calling function
        DisplayForm()



        top.mainloop()

    




