def login():
    connection = sqlite3.connect("kayak.db")
    cursor = connection.cursor()
    cursor.execute('SELECT instructorRole FROM tblinstructors WHERE instructorUsername=? AND instructorPassword =?',(entryUsername.get(),entryPassword.get()))
    result = cursor.fetchone()

    #binary earch function used to accept a list of the userdata
    #the username and password that has been entered, low is the lowest value in the list to be searched amd high the max index of the list to be searched
    def binarySearch(userList, username, password, low, high):

        if high >= low:
            mid = (low + high)//2

            if mid > (len(userList)-1):
                return False
            
            elif (userList[mid][0] > username):
                return binarySearch(userList, username, password, low, mid-1)
            elif (userList[mid][0] < username):
                return binarySearch(userList, username, password, mid+1, high)
            else:
                if userList[mid][1] == password:
                    return True
                else:
                    return False
        else:
            return False
    
    #creating a list of all login details
    connection = sqlite3.connect("kayak.db")
    cursor = connection.cursor()
    users = []
    for row in cursor.execute("SELECT instructorUsername, instructorPassword FROM tblinstructors"):
        users.append(row)

    #Apply bubble sort to users
    #Sort the data by surname
    for i in range(len(users)-1):
        for j in range(len(users)-i-1):
            if users[j][0] > users[j+1][0]:
                users[j], users[j+1] = users[j+1], users[j]

    #creating variables based on the user entry fields
    pword = entryPassword.get()
    uname = entryUsername.get()

    #creating a variable used to store a value of true or false depending on if a record has been found that matches the details entered
    found = binarySearch(users, uname, pword, 0, len(users))

    #If the info entered does not match a record in the database then an error message is shown
    if result == None:
    #If the login details entered does not match a record in the database then an error message is shown
        messagebox.showinfo(title="Incorrect username or password", message="Error - you have entered the wrong username or password")
    else:
        #user is redirected to the main menu if they enter the correct details
        #if the user is a leader then they are redirected to a main menu which only has access to a small amount of the database
        #if they arent then they are redirected to the normal main menu with access to the whole database
        roleCheck = result[0]
        #global variable is requiered so that it can be called upon again later when required
